# Server Port configuration
PORT=5001

# Browser Anti-Detection & Headless Settings
# 0 = headed under Xvfb (recommended for low bot-detection scores)
BROWSER_HEADLESS=0

# Security (allow private/loopback targets only in development)
SOLVER_ALLOW_PRIVATE=0

# Optional: Public URL if deployed behind reverse proxy / domain
SOLVER_PUBLIC_URL=http://localhost:5001

# Optional ngrok configuration (leave empty if not using ngrok)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
ENABLE_NGROK=0

# SEO Rank Collector settings
SERP_WORKER_CONCURRENCY=1
SERP_DEFAULT_DEPTH=50
